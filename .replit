modules = ["nodejs-24", "python-3.11", "bun", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mcp-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cron"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prod-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tutorial-pdf"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "supabase-types"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "\"$(available-pid2-node-paths | head -1)\" node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 8080"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "mcp-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun test src/lib/mcp"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cron"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/aurora-cron-daemon.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "prod-build"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && NODE_OPTIONS=--max-old-space-size=4608 bash scripts/replit-node.sh node_modules/vite/bin/vite.js build"

[[workflows.workflow]]
name = "mcp-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun test src/lib/mcp"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "tutorial-pdf"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-tutorial-pdf-fresh.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:e2e"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx playwright install chromium 2>/dev/null; npm run test:e2e"

[[workflows.workflow]]
name = "supabase-types"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-supabase-types.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.shared]
VITE_SUPABASE_URL = "https://tpzmvbczwahxajujvnrq.supabase.co"
SUPABASE_URL = "https://tpzmvbczwahxajujvnrq.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY = "sb_publishable_SGO6FEm9zbgYEOsFqlSX8Q_dFVMJf4x"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_SGO6FEm9zbgYEOsFqlSX8Q_dFVMJf4x"
VITE_GTM_CONTAINER_ID = "GTM-MW3PPLW9"
