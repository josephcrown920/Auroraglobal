INFERENCE_SH_APP_VIDEO = "google/veo-3-1-fast"
VITE_ADMIN_PASSCODE = "muddyman"

[objectStorage]
defaultBucketID = "replit-objstore-92420312-7368-4c29-8394-f3bd7ba1e2dd"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
