# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Publishing does not need the repository history. Keeping this out of the
# publish input avoids shipping several gigabytes of Git/LFS objects.
.git
dist
dist-ssr
.output
.build-snapshots
.cache/
.pythonlibs/
.scaffold-backup/
attached_assets/
.vinxi
.tanstack/**
.nitro
*.local
.local/

# Playwright e2e artifacts
playwright-report/
test-results/
blob-report/

# Stray root-level artifact temp (platform blocks deleting it; flat-root apps
# cannot be root artifacts). Root-anchored so artifacts/<slug>/.replit-artifact/
# stays tracked.
/.replit-artifact/

# Stray root-level artifact temp (platform blocks deleting it; flat-root apps
# cannot be root artifacts). Root-anchored so artifacts/<slug>/.replit-artifact/
# stays tracked.
/.replit-artifact/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — NEVER commit. Real values live in Lovable Cloud → Secrets.
# Only `.env.example` (template, no real values) is allowed in git.
# Covers Kling (KLING_ACCESS_KEY / KLING_SECRET_KEY) and every other runtime
# secret documented in docs/ENV.md and docs/KLING_SECRETS.md.
.env
.env.*
!.env.example
*.env
*.env.local
secrets.json
secrets.*.json
kling.json
kling.*.json
**/kling-credentials*

# Large GPU worker template archives — stored in Replit Object Storage instead
# of git (they exceed GitHub's 100 MB limit and bloat the repo). See
# attached_assets/GPU_TEMPLATES.README.md for download instructions.
attached_assets/Collab_inference*.zip
attached_assets/Latentsync_export*.zip
attached_assets/PerformAnywhereExport*.zip
attached_assets/Motion_transfer_studio*.zip
# Catch-all: never commit zip archives — uploads/exports belong in Object Storage,
# not in git (they bloat the repo and exceed GitHub's 100 MB limit).
attached_assets/*.zip
notebooks/*.zip
*.zip

# Dev-only dependencies and store exports inside auxiliary artifacts.
artifacts/*/node_modules/
artifacts/*/.expo/
artifacts/aurora-mobile/store/builds/

# Raw generated media staging area. Generated clips/images land here first,
# then get copied into their permanent home (e.g. src/assets/kids/,
# public/videos/) for use in the app. The staging copies must never be
# committed too, or every regeneration duplicates multi-MB media in git
# (happened with kids_*.mp4 duplicating src/assets/kids/*.mp4).
attached_assets/generated_videos/
attached_assets/generated_images/

# bun lockfiles hijack remote builds (deployer/EAS) — npm package-lock.json is authoritative
bun.lock
bun.lockb
