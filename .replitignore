# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# ── Dev-workspace directories (never needed at runtime) ──────────────────────

# Git history (~4.4 GB) — not needed in the deployed container
.git
.git/**

# Replit workspace caches (~3.1 GB: playwright, typescript, pip, bun, node-gyp…)
.cache

# Agent/skill files and pnpm store (~529 MB)
.local

# Python dev-tooling venv (~72 MB). Its bin/ also contains a `node` symlink into
# the dev Nix store that dangles inside the production image and breaks any
# bare `node` invocation that resolves through it.
.pythonlibs

# Attached assets uploaded during development (~2 GB of videos, ZIPs, PDFs)
attached_assets

# Build caches — regenerated during the deploy build, never needed at runtime.
#
# DO NOT add `.output` here. The deployer builds INSIDE the workspace and THEN
# snapshots it into the image through this filter, so ignoring `.output` strips
# the freshly built Nitro server bundle out of the image. At runtime the
# process then dies instantly with
#   node:internal/modules/cjs/loader — Cannot find module '.../.output/server/index.mjs'
# port 8080 never opens, and promote fails with
#   "a port configuration was specified but the required port was never opened".
.vinxi
.tanstack
.nitro

# The deploy builder installs dependencies before running the production build,
# but the generated Nitro server does not need the workspace dependency tree at
# runtime. Excluding it saves about 1.8 GiB and removes dev-only native binaries.
node_modules
node_modules/**

# Dev notebooks, docs, screenshots, and one-off scripts
notebooks
screenshots
QA_REPORT.md
gen-josh-pdf.js

# Lock files (deployer installs from package.json; bun.lock causes stale-pin issues)
bun.lock
package-lock.json

# Per-artifact dev dependencies (~1.8 GB) — the production deploy only builds and
# serves the flat-root app; artifact preview apps are dev-only
artifacts/*/node_modules
artifacts/aurora-mobile/.expo
