{
  "expo": {
    "name": "Aurora Studio",
    "slug": "aurora-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aurora-studio",
    "userInterfaceStyle": "dark",
    "privacyPolicyUrl": "https://auroraperformancestudio.com/privacy",
    "supportUrl": "mailto:support@auroraperformancestudio.com",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b14"
    },
    "android": {
      "package": "com.aurorastudio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0b0b14"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.aurorastudio.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Aurora uses your camera to capture photos for AI generation.",
        "NSPhotoLibraryUsageDescription": "Aurora accesses your photo library to use images as reference for AI generation.",
        "NSPhotoLibraryAddUsageDescription": "Aurora saves your AI-generated images to your photo library.",
        "NSMicrophoneUsageDescription": "Aurora may use the microphone for voice-assisted features.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://auroraperformancestudio.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aurora Studio to access your photos to use as reference images for AI generation.",
          "cameraPermission": "Allow Aurora Studio to use your camera to capture photos for AI generation."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
