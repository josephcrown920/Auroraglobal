# Copy this to .env and fill in your values.
# These are PUBLIC frontend values — safe to expose in the browser.

# Supabase project URL and anon key (from your Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# In production: point at your deployed Aurora backend.
# In development (via Vite proxy) this is set automatically.
VITE_AURORA_URL=https://your-aurora-app.replit.app
