{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Aurora Design System tokens (DTCG). Single source of truth — edit only this file. Brand: deep navy-dark / white-light, violet primary (oklch 0.60 0.27 295), Plus Jakarta Sans UI font, 0.625rem base radius.",
  "color": {
    "$type": "color",
    "dark": {
      "background":           { "$value": "#07090e", "$description": "Page background — deep navy-black" },
      "foreground":           { "$value": "#f8f8f8" },
      "card":                 { "$value": "#0c1020", "$description": "Card surface — slightly lighter navy" },
      "cardForeground":       { "$value": "#f8f8f8" },
      "popover":              { "$value": "#0c1020" },
      "popoverForeground":    { "$value": "#f8f8f8" },
      "primary":              { "$value": "#9343ff", "$description": "Violet brand accent — oklch 0.60 0.27 295" },
      "primaryForeground":    { "$value": "#faf8f8" },
      "secondary":            { "$value": "#0d1223" },
      "secondaryForeground":  { "$value": "#f8f8f8" },
      "muted":                { "$value": "#0a0d1c" },
      "mutedForeground":      { "$value": "#828693" },
      "accent":               { "$value": "#14162e" },
      "accentForeground":     { "$value": "#f8f8f8" },
      "destructive":          { "$value": "#e03131", "$description": "Semantic error/danger — reserved, not brand" },
      "destructiveForeground":{ "$value": "#f8f8f8" },
      "border":               { "$value": "#1c2036" },
      "input":                { "$value": "#1e2438" },
      "ring":                 { "$value": "#9343ff" },
      "chart1":               { "$value": "#e06a20" },
      "chart2":               { "$value": "#1a9689" },
      "chart3":               { "$value": "#104e64" },
      "chart4":               { "$value": "#d4a800" },
      "chart5":               { "$value": "#d07a00" },
      "sidebar":              { "$value": "#050810" },
      "sidebarForeground":    { "$value": "#f8f8f8" },
      "sidebarBorder":        { "$value": "#171b2c" },
      "sidebarPrimary":       { "$value": "#9343ff" },
      "sidebarPrimaryForeground": { "$value": "#faf8f8" },
      "sidebarAccent":        { "$value": "#0d1223" },
      "sidebarAccentForeground": { "$value": "#f8f8f8" },
      "sidebarRing":          { "$value": "#9343ff" }
    },
    "light": {
      "background":           { "$value": "#ffffff" },
      "foreground":           { "$value": "#04050d" },
      "card":                 { "$value": "#f4f5f9" },
      "cardForeground":       { "$value": "#04050d" },
      "popover":              { "$value": "#f4f5f9" },
      "popoverForeground":    { "$value": "#04050d" },
      "primary":              { "$value": "#8228f6", "$description": "Violet brand accent — oklch 0.54 0.27 295" },
      "primaryForeground":    { "$value": "#fcfcfc" },
      "secondary":            { "$value": "#e9ebf1" },
      "secondaryForeground":  { "$value": "#080b14" },
      "muted":                { "$value": "#edeef3" },
      "mutedForeground":      { "$value": "#545864" },
      "accent":               { "$value": "#e5e8ef" },
      "accentForeground":     { "$value": "#080b14" },
      "destructive":          { "$value": "#df000a" },
      "destructiveForeground":{ "$value": "#fcfcfc" },
      "border":               { "$value": "#e3e6ef" },
      "input":                { "$value": "#e3e6ef" },
      "ring":                 { "$value": "#8228f6" },
      "chart1":               { "$value": "#e55a00" },
      "chart2":               { "$value": "#00786c" },
      "chart3":               { "$value": "#004157" },
      "chart4":               { "$value": "#d49000" },
      "chart5":               { "$value": "#d57400" },
      "sidebar":              { "$value": "#f4f5f9" },
      "sidebarForeground":    { "$value": "#04050d" },
      "sidebarBorder":        { "$value": "#dde0ec" },
      "sidebarPrimary":       { "$value": "#8228f6" },
      "sidebarPrimaryForeground": { "$value": "#fcfcfc" },
      "sidebarAccent":        { "$value": "#e5e8ef" },
      "sidebarAccentForeground": { "$value": "#080b14" },
      "sidebarRing":          { "$value": "#8228f6" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Plus Jakarta Sans", "Inter", "sans-serif"], "$description": "Primary UI and body typeface (CapCut-style feel)" },
      "serif": { "$value": ["Cormorant Garamond", "Georgia", "serif"],   "$description": "Editorial and display accents" },
      "mono":  { "$value": ["JetBrains Mono", "Menlo", "monospace"],     "$description": "Code and monospace surfaces" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.625rem", "$description": "Aurora base radius — matches the main app's --radius: 0.625rem" }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
